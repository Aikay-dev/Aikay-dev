# ---------------------------------------------------------------------------
# Spotify — the "now playing" strip in the footer.
#
# 1. Create an app at https://developer.spotify.com/dashboard
# 2. Add http://127.0.0.1:8888/callback as a Redirect URI
# 3. Put the client id + secret below
# 4. Run `npm run spotify:auth` and follow the printed URL once
# 5. Paste the refresh token it prints back here
#
# Leave these unset and the widget simply doesn't render.
# ---------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# GitHub — the "still building" strip.
#
# The latest-commit line works without a token (60 req/hour, and the page
# revalidates hourly). A fine-grained token with public read access raises the
# limit and enables the contribution heatmap, which needs the GraphQL API.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# EmailJS — the contact form.
#
# These three are public by design; they ship in the browser bundle on every
# request. The live values are already committed as defaults in
# src/components/contact-form.tsx, so the form works without setting anything
# here — these only override them.
#
# The real protection is the domain allowlist: EmailJS dashboard →
# Account → Security. Without it, anyone can post to the template from anywhere.
#
# The live template renders {{name}}, {{email}}, {{message}} and {{time}} only.
# Anything sent under another key is accepted and silently discarded, which is
# why company and budget are folded into the message body.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
